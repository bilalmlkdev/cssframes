{
  "name": "cssframes",
  "private": true,
  "version": "1.0.0",
  "description": "Pure CSS keyframe animations you can preview, copy, and paste. No JavaScript, no dependencies.",
  "keywords": [
    "css",
    "css-animations",
    "keyframes",
    "animation-library",
    "pure-css"
  ],
  "type": "module",
  "author": "Bilal Malik (bilalmlkdev)",
  "license": "MIT",
  "homepage": "https://cssframes.vercel.app",
  "bugs": {
    "url": "https://github.com/bilalmlkdev/cssframes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bilalmlkdev/cssframes.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "css": "node scripts/build-css.mjs",
    "prebuild": "node scripts/build-css.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "lucide-react": "^1.7.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.4"
  }
}
